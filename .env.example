# Production: use the project's own OpenRouter key, named "Startup Copilot" in OpenRouter (credit limit set).
# Put it in .env.local on the server, which git ignores. Never commit the key.
OPENROUTER_API_KEY=
# Optional. Any id from https://openrouter.ai/api/v1/models
OPENROUTER_MODEL=openai/gpt-5.5
# Optional. AI requests per client IP per UTC day.
AI_DAILY_LIMIT=5
